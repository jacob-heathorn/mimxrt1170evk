load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cores.bzl", "CM7")
load("//bazel:hal.bzl", "DEBUG_DEFINES", "HAL_COPTS", "SDK_DEFINES")

package(default_visibility = ["//visibility:public"])

# ARM CMSIS core headers.
cc_library(
    name = "cmsis",
    hdrs = glob(["cmsis/*.h"]),
    includes = ["cmsis"],
    target_compatible_with = CM7,
)

# NXP device headers and system init; carries the SDK configuration for everything above it.
cc_library(
    name = "device",
    srcs = glob(["device/*.c"]),
    hdrs = glob(["device/*.h"]),
    copts = HAL_COPTS,
    defines = [
        "CPU_MIMXRT1176DVMAA_cm7",
        "XIP_BOOT_HEADER_ENABLE=1",
        "XIP_EXTERNAL_FLASH=1",
    ] + SDK_DEFINES + DEBUG_DEFINES,
    includes = ["device"],
    target_compatible_with = CM7,
    deps = [":cmsis"],
)

# NXP peripheral drivers (fsl_*).
cc_library(
    name = "drivers",
    srcs = glob(["drivers/*.c"]),
    hdrs = glob(["drivers/*.h"]),
    copts = HAL_COPTS,
    includes = ["drivers"],
    target_compatible_with = CM7,
    deps = [":device"],
)

# NXP debug console, asserts and the _sbrk heap hook.
cc_library(
    name = "utilities",
    srcs = glob([
        "utilities/*.c",
        "utilities/*.S",
    ]),
    hdrs = glob(["utilities/*.h"]),
    copts = HAL_COPTS,
    includes = ["utilities"],
    # Resolve _sbrk from fsl_sbrk.c rather than the nosys stub, so malloc has a heap.
    linkopts = ["-Wl,--undefined=_sbrk"],
    target_compatible_with = CM7,
    deps = [
        ":device",
        ":drivers",
    ],
)

# NXP board support: clocks and pin mux for the EVK.
cc_library(
    name = "board",
    srcs = glob(["board/*.c"]),
    hdrs = glob(["board/*.h"]),
    copts = HAL_COPTS,
    includes = ["board"],
    target_compatible_with = CM7,
    deps = [
        ":drivers",
        ":utilities",
    ],
)

# NXP multicore manager. Its interrupt handlers are reached only through the vector table, so keep
# them linked.
cc_library(
    name = "mcmgr",
    srcs = glob(["mcmgr/*.c"]),
    hdrs = glob(["mcmgr/*.h"]),
    copts = HAL_COPTS + ["-Wno-cast-align"],
    includes = ["mcmgr"],
    target_compatible_with = CM7,
    deps = [
        ":device",
        ":drivers",
    ],
    alwayslink = True,
)
