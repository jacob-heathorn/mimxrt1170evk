build --enable_bzlmod
build --incompatible_strict_action_env

# Tuck convenience symlinks under one hidden dir so the repo root stays
# uncluttered. Same convention as forge.
build --symlink_prefix=.bazel/

# Test output: show errors immediately rather than burying them in log files.
test --test_output=errors

# Treat external-repo headers as system headers so our -Werror set doesn't
# fire inside vendored NXP SDK / forge / etl code.
build --features=external_include_paths

# C++20 across the build.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Cortex-M4 cross-compile config. Picks the arm-none-eabi toolchain via
# --platforms and adds the CPU-specific flags. Use as:
#   bazel build --config=cm4 //...
build:cm4 --platforms=//platforms:cm4
build:cm4 --copt=-mcpu=cortex-m4
build:cm4 --copt=-mfpu=fpv4-sp-d16
build:cm4 --copt=-mfloat-abi=hard
build:cm4 --copt=-mthumb
build:cm4 --copt=-mapcs
build:cm4 --linkopt=-mcpu=cortex-m4
build:cm4 --linkopt=-mfpu=fpv4-sp-d16
build:cm4 --linkopt=-mfloat-abi=hard
build:cm4 --linkopt=-mthumb

# NXP MIMXRT1176 CM4 defines (mirrors the cmake build).
build:cm4 --copt=-DCPU_MIMXRT1176DVMAA_cm4
build:cm4 --copt=-DMCUXPRESSO_SDK
build:cm4 --copt=-DMULTICORE_APP=1
build:cm4 --copt=-DMCMGR_HANDLE_EXCEPTIONS=1
build:cm4 --copt=-DFLEXSPI_IN_USE
build:cm4 --copt=-D__SEMIHOST_HARDFAULT_DISABLE=1
build:cm4 --copt=-D__STARTUP_CLEAR_BSS
build:cm4 --copt=-D__STARTUP_INITIALIZE_NONCACHEDATA
build:cm4 --copt=-DDEBUG

# Match cmake's debug preset: -O0 -g -flto=auto. Once we split a separate
# release config, move these into a debug-only block.
build:cm4 --copt=-O0
build:cm4 --copt=-g
# TODO: re-enable -flto=auto. cmake's debug build uses it; bazel needs
# alwayslink + likely a custom link feature that exposes the LTO plugin
# correctly to the linker so archived symbols aren't dropped. See TODO.md.

# Freestanding C/C++ for embedded.
build:cm4 --copt=-ffunction-sections
build:cm4 --copt=-fdata-sections
build:cm4 --copt=-fno-common
build:cm4 --copt=-ffreestanding
build:cm4 --copt=-fno-builtin
build:cm4 --cxxopt=-fno-exceptions
build:cm4 --cxxopt=-fno-rtti
build:cm4 --cxxopt=-fno-use-cxa-atexit

# Match cmake's link group + nano/nosys specs.
build:cm4 --linkopt=--specs=nano.specs
build:cm4 --linkopt=--specs=nosys.specs
build:cm4 --linkopt=-Wl,--start-group
build:cm4 --linkopt=-lm
build:cm4 --linkopt=-lc
build:cm4 --linkopt=-lgcc
build:cm4 --linkopt=-lnosys
build:cm4 --linkopt=-Wl,--end-group
build:cm4 --linkopt=-Wl,--gc-sections
build:cm4 --linkopt=-Wl,--print-memory-usage
build:cm4 --linkopt=-static
build:cm4 --linkopt=-Xlinker
build:cm4 --linkopt=-z
build:cm4 --linkopt=-Xlinker
build:cm4 --linkopt=muldefs

# Cortex-M7 cross-compile config (mirrors cmake/cm7/platform.cmake).
build:cm7 --platforms=//platforms:cm7
build:cm7 --copt=-mcpu=cortex-m7
build:cm7 --copt=-mfpu=fpv5-d16
build:cm7 --copt=-mfloat-abi=hard
build:cm7 --copt=-mthumb
build:cm7 --copt=-mapcs
build:cm7 --linkopt=-mcpu=cortex-m7
build:cm7 --linkopt=-mfpu=fpv5-d16
build:cm7 --linkopt=-mfloat-abi=hard
build:cm7 --linkopt=-mthumb

# CM7 defines.
build:cm7 --copt=-DCPU_MIMXRT1176DVMAA_cm7
build:cm7 --copt=-DMCUXPRESSO_SDK
build:cm7 --copt=-DMULTICORE_APP=1
build:cm7 --copt=-DMCMGR_HANDLE_EXCEPTIONS=1
build:cm7 --copt=-DFLEXSPI_IN_USE
build:cm7 --copt=-DXIP_BOOT_HEADER_ENABLE=1
build:cm7 --copt=-DXIP_EXTERNAL_FLASH=1
build:cm7 --copt=-D__SEMIHOST_HARDFAULT_DISABLE=1
build:cm7 --copt=-D__STARTUP_CLEAR_BSS
build:cm7 --copt=-D__STARTUP_INITIALIZE_NONCACHEDATA
build:cm7 --copt=-DDEBUG

build:cm7 --copt=-O0
build:cm7 --copt=-g
# TODO: re-enable -flto=auto. See cm4 note above.

build:cm7 --copt=-ffunction-sections
build:cm7 --copt=-fdata-sections
build:cm7 --copt=-fno-common
build:cm7 --copt=-ffreestanding
build:cm7 --copt=-fno-builtin
build:cm7 --cxxopt=-fno-exceptions
build:cm7 --cxxopt=-fno-rtti
build:cm7 --cxxopt=-fno-use-cxa-atexit

build:cm7 --linkopt=--specs=nano.specs
build:cm7 --linkopt=--specs=nosys.specs
build:cm7 --linkopt=-Wl,--start-group
build:cm7 --linkopt=-lm
build:cm7 --linkopt=-lc
build:cm7 --linkopt=-lgcc
build:cm7 --linkopt=-lnosys
build:cm7 --linkopt=-Wl,--end-group
build:cm7 --linkopt=-Wl,--gc-sections
build:cm7 --linkopt=-Wl,--print-memory-usage
build:cm7 --linkopt=-static
build:cm7 --linkopt=-Xlinker
build:cm7 --linkopt=-z
build:cm7 --linkopt=-Xlinker
build:cm7 --linkopt=muldefs

# Allow a developer overlay (gitignored).
try-import %workspace%/user.bazelrc
