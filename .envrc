# Set project directories.
export PROJECT_ROOT=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
export MIMXRT1170EVK_ROOT=$PROJECT_ROOT
export FORGE_ROOT=$(gordion -f forge)

# Use nix-direnv
if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

use flake $FORGE_ROOT/flakes/native-shell

# Set serial terminal device port
export SERIAL_DEVICE=/dev/ttyACM0

# Add command path
export PATH=$PATH:$PROJECT_ROOT/scripts/bin

# Set paths to some external tools
export ARM_GCC_TOOLCHAIN_PATH=/nix/store/xds2q9qipa6123ycfbak5g5xpf0bxivf-gcc-arm-embedded-13.3.rel1/bin
export LINK_SERVER="/usr/local/LinkServer_1.4.85/LinkServer"

# Source the common environment script
source $FORGE_ROOT/scripts/common.envrc

