#!/usr/bin/env bash
# Bazel wrapper. bazelisk auto-detects this file (when invoked from the
# repo root) and execs it instead of the real bazel binary, passing
# BAZEL_REAL with the resolved binary path.
#
# Purpose: resolve gordion-managed bzlmod deps. Their on-disk paths can
# change between machines/checkouts (sibling vs gordion's private cache)
# so we re-discover them on every invocation and write the result into
# user.bazelrc as --override_module flags. After that, real bazel reads
# user.bazelrc and the build proceeds normally.
#
# To add a new gordion-managed bzlmod dep, add its name to GORDION_MODULES.

set -euo pipefail

# bzlmod modules whose source path comes from `gordion -f <name>`.
GORDION_MODULES=(forge)

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
overrides_file="${workspace}/user.bazelrc"

{
    echo "# Auto-generated by tools/bazel from gordion. Do not edit by hand."
    for module in "${GORDION_MODULES[@]}"; do
        if path="$(gordion -f "$module" 2>/dev/null)" && [[ -n "$path" ]]; then
            echo "common --override_module=${module}=${path}"
        else
            echo "# WARNING: gordion -f ${module} failed; module not overridden." >&2
        fi
    done
} > "$overrides_file"

exec "${BAZEL_REAL:-bazel}" "$@"
