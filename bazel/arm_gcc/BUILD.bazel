# Toolchain bindings: pair @arm_gcc//:cm{4,7}_cc_toolchain with the
# corresponding platform constraint. Each cc_toolchain has its own
# CPU/FPU/define feature set baked in (see @arm_gcc/toolchain_config.bzl)
# so building with --platforms=//platforms:cm{4,7} alone gives the
# right flags — no --config=cm{4,7} required for correctness.

toolchain(
    name = "cm4_toolchain",
    toolchain = "@arm_gcc//:cm4_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    target_compatible_with = [
        "@platforms//cpu:armv7e-m",
        "@platforms//os:none",
        "//platforms:cm4_core",
    ],
)

toolchain(
    name = "cm7_toolchain",
    toolchain = "@arm_gcc//:cm7_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    target_compatible_with = [
        "@platforms//cpu:armv7e-m",
        "@platforms//os:none",
        "//platforms:cm7_core",
    ],
)
