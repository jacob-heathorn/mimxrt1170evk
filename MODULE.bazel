module(name = "mimxrt1170evk")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "forge", version = "0.1.0")
bazel_dep(name = "microcyphal", version = "0.1.0")

# Gordion checkouts in the workspace take precedence via tools/bazel; see gordion's README.
git_override(
    module_name = "forge",
    commit = "db4d0697b834e9ccfc0dea6b0838388e83c1fcab",
    remote = "https://github.com/jacob-heathorn/forge.git",
)

git_override(
    module_name = "microcyphal",
    commit = "7014a7b1f2a5db51a4ef03c85cd8ee623b9e728f",
    remote = "https://github.com/jacob-heathorn/microcyphal.git",
)

# Downloads the Arm GNU Toolchain; //bazel/toolchains/arm_gcc turns it into a toolchain per core.
arm_gcc = use_extension("//bazel/toolchains/arm_gcc:extension.bzl", "arm_gcc")
use_repo(arm_gcc, "arm_gcc")

register_toolchains("//bazel/toolchains/arm_gcc:all")

# The vendored NXP SDK for each core, as external repositories so their headers count as system
# headers and our warnings do not fire inside them.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

[
    new_local_repository(
        name = "nxp_" + core,
        build_file = "//third_party:nxp_{}.BUILD".format(core),
        path = "firmware/{}/legacy".format(core),
    )
    for core in [
        "cm4",
        "cm7",
    ]
]

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "threadx",
    build_file = "//third_party:threadx.BUILD",
    sha256 = "0a9a07a94d654d8589277edeaf874905b372da64d1dc7b6d9ec5d4136c7ed098",
    strip_prefix = "threadx-6.4.2_rel",
    urls = ["https://github.com/eclipse-threadx/threadx/archive/refs/tags/v6.4.2_rel.tar.gz"],
)

http_archive(
    name = "netxduo",
    build_file = "//third_party:netxduo.BUILD",
    sha256 = "301f26f536bde1ab51ad221dde6268f5375ce9c6ed44cf836ca004265d3708b7",
    strip_prefix = "netxduo-6.4.2_rel",
    urls = ["https://github.com/eclipse-threadx/netxduo/archive/refs/tags/v6.4.2_rel.tar.gz"],
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

[
    http_file(
        name = "mimxrt1176_{}_svd".format(core),
        sha256 = sha256,
        url = "https://raw.githubusercontent.com/nxp-mcuxpresso/mcux-soc-svd/MCUX_2.16.100/MIMXRT1176/MIMXRT1176_{}.xml".format(core),
    )
    for core, sha256 in [
        ("cm4", "2c1acd622b12c18a887d75ec291c628756daef22272d6f986f9980c45f10251f"),
        ("cm7", "8daeb97c4a787edc6bd9a755e83e2fec889f58758c33940bddd422081c29e0ab"),
    ]
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
