load("//bazel:cores.bzl", "cm7_image")
load("//tools:flash.bzl", "flash")

# Field-oriented motor control with an AS5600 encoder over LPI2C.
cm7_image(
    name = "foc",
    srcs = ["main.cpp"],
    deps = [
        "//firmware/cm7:drivers",
        "//firmware/cm7:runtime",
    ],
)

flash(
    name = "foc.flash",
    image = ":foc",
)
