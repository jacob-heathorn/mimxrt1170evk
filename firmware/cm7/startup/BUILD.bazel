load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# FlexSPI NOR boot config — referenced by name from a fixed flash offset
# at boot. alwayslink + --whole-archive at consumer-side keeps the linker
# from gc-ing it because no app code references it directly.
cc_library(
    name = "boot",
    srcs = [
        "boot/evkmimxrt1170_flexspi_nor_config.c",
        "boot/fsl_flexspi_nor_boot.c",
    ],
    hdrs = [
        "boot/evkmimxrt1170_flexspi_nor_config.h",
        "boot/fsl_flexspi_nor_boot.h",
    ],
    includes = ["boot"],
    copts = ["-Wno-sign-conversion"],
    deps = ["//firmware/cm7/legacy:drivers"],
    alwayslink = True,
)

cc_library(
    name = "system_init",
    srcs = ["system_init/system_init_hook.cpp"],
    deps = [
        "//firmware/cm7:cm7-platform",
        "//firmware/cm7:registers",
        "//firmware/cm7:utils",
        "//firmware/cm7/legacy:board",
        "//firmware/cm7/legacy:mcmgr",
        "//firmware/cm7/legacy:utilities",
    ],
)

# Reset_Handler + interrupt vector table + linker script. Consumers link
# this and inherit the linker script via linkopts. `:boot` is included
# transitively (alwayslink=True on that target already forces its
# objects in via --whole-archive — no explicit linkopt needed; doing it
# twice would duplicate the IVT/flash_config sections).
cc_library(
    name = "rt1170-startup-cm7",
    srcs = ["startup_mimxrt1176_cm7.S"],
    additional_linker_inputs = ["mimxrt1176_cm7_flexspi_nor.ld"],
    linkopts = ["-T$(execpath mimxrt1176_cm7_flexspi_nor.ld)"],
    alwayslink = True,
    deps = [
        ":boot",
        ":system_init",
    ],
)
