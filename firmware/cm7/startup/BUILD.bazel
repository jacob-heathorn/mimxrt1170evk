load("@forge//bazel/platforms:cores.bzl", "CM7")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//firmware:hal.bzl", "HAL_COPTS")

package(default_visibility = ["//visibility:public"])

# The boot header is found by flash offset, not by reference, so keep it linked.
cc_library(
    name = "boot",
    srcs = [
        "boot/evkmimxrt1170_flexspi_nor_config.c",
        "boot/fsl_flexspi_nor_boot.c",
    ],
    hdrs = [
        "boot/evkmimxrt1170_flexspi_nor_config.h",
        "boot/fsl_flexspi_nor_boot.h",
    ],
    copts = HAL_COPTS,
    includes = ["boot"],
    target_compatible_with = CM7,
    deps = ["//firmware/cm7/legacy:drivers"],
    alwayslink = True,
)

cc_library(
    name = "system_init",
    srcs = ["system_init/system_init_hook.cpp"],
    target_compatible_with = CM7,
    deps = [
        "//firmware/cm7:cm7-platform",
        "//firmware/cm7:registers",
        "//firmware/cm7:utils",
        "//firmware/cm7/legacy:board",
        "//firmware/cm7/legacy:mcmgr",
        "//firmware/cm7/legacy:utilities",
    ],
)

# Reset_Handler is reached only through the entry point, so keep it linked.
cc_library(
    name = "rt1170-startup-cm7",
    srcs = ["startup_mimxrt1176_cm7.S"],
    additional_linker_inputs = ["mimxrt1176_cm7_flexspi_nor.ld"],
    linkopts = ["-T$(execpath mimxrt1176_cm7_flexspi_nor.ld)"],
    target_compatible_with = CM7,
    deps = [
        ":boot",
        ":system_init",
    ],
    alwayslink = True,
)
