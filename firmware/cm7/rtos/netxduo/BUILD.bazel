load("@forge//bazel/platforms:cores.bzl", "CM7")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//firmware:hal.bzl", "HAL_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nx_user",
    hdrs = ["nx_user.h"],
    includes = ["."],
    target_compatible_with = CM7,
)

# NetX Duo driver for the RT1170's ENET controllers. Its interrupt handlers are reached only
# through the vector table, so keep them linked.
cc_library(
    name = "netxduo",
    srcs = [
        "nx_driver_imxrt.c",
        "nx_driver_imxrt_irq.c",
    ],
    hdrs = ["nx_driver_imxrt.h"],
    copts = HAL_COPTS,
    includes = ["."],
    target_compatible_with = CM7,
    deps = [
        "//firmware/cm7/legacy:board",
        "//firmware/cm7/legacy:drivers",
        "//firmware/cm7/rtos/threadx",
        "@netxduo",
    ],
    alwayslink = True,
)
