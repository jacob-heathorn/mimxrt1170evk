load("//bazel:cores.bzl", "cm7_library")

package(default_visibility = ["//visibility:public"])

# Our ThreadX configuration, included by the kernel as tx_user.h.
cm7_library(
    name = "tx_user",
    hdrs = ["tx_user.h"],
    includes = ["."],
)

# Our port glue: SysTick setup and the stack overflow handler. The kernel archive references
# these, so they must already be linked when it is scanned.
cm7_library(
    name = "threadx",
    srcs = [
        "tx_initialize_low_level.c",
        "tx_thread_stack_error.cpp",
    ],
    deps = [
        "@forge//firmware/threadx:ftl-threadx",
        "@nxp_cm7//:drivers",
        "@threadx",
    ],
    alwayslink = True,
)

# main() for pigweed test images: runs the tests in a ThreadX thread.
cm7_library(
    name = "pw_ut_main",
    srcs = ["pw_ut_main.cpp"],
    deps = [
        ":threadx",
        "//firmware/cm7:utils",
        "@forge//firmware/ftl",
        "@forge//firmware/pw_unit_test",
        "@forge//firmware/threadx:ftl-threadx",
    ],
    alwayslink = True,
)
