load("@forge//bazel/platforms:cores.bzl", "CM7")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Committed SVD codegen output; see TODO.md for generating it in the build.
cc_library(
    name = "registers",
    hdrs = glob(["registers/**/*.hpp"]),
    includes = ["."],
    target_compatible_with = CM7,
    deps = ["@forge//firmware/ftl"],
)

cc_library(
    name = "utils",
    hdrs = glob(["utils/*.hpp"]),
    includes = ["."],
    target_compatible_with = CM7,
)

cc_library(
    name = "drivers",
    srcs = glob(["drivers/*.cpp"]),
    hdrs = glob(["drivers/*.hpp"]),
    includes = ["."],
    target_compatible_with = CM7,
    deps = [
        ":registers",
        "//firmware/cm7/legacy:drivers",
    ],
)

# syscalls.cpp must be linked ahead of newlib's nosys stubs to route printf to the console.
cc_library(
    name = "cm7-platform",
    srcs = glob(["platform/*.cpp"]),
    hdrs = glob(["platform/include/**/*.hpp"]),
    includes = [
        ".",
        "platform/include",
    ],
    target_compatible_with = CM7,
    deps = [
        ":drivers",
        ":registers",
        ":utils",
        "//firmware/cm7/legacy:board",
        "//firmware/cm7/legacy:cmsis",
        "//firmware/cm7/legacy:utilities",
    ],
    alwayslink = True,
)
