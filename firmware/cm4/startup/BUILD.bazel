load("@forge//bazel/platforms:cores.bzl", "CM4")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//firmware:hal.bzl", "HAL_COPTS")

cc_library(
    name = "system_init",
    srcs = ["system_init/system_MIMXRT1176_cm4.c"],
    hdrs = glob(["system_init/*.h"]),
    copts = HAL_COPTS,
    includes = ["system_init"],
    target_compatible_with = CM4,
    deps = [
        "//firmware/cm4:cmsis",
        "//firmware/cm4:device",
    ],
)

# Reset_Handler is reached only through the entry point, so keep it linked.
cc_library(
    name = "rt1170-startup-cm4",
    srcs = ["startup_MIMXRT1176_cm4.S"],
    additional_linker_inputs = ["MIMXRT1176xxxxx_cm4_ram.ld"],
    linkopts = ["-T$(execpath MIMXRT1176xxxxx_cm4_ram.ld)"],
    target_compatible_with = CM4,
    visibility = ["//visibility:public"],
    deps = [":system_init"],
    alwayslink = True,
)
