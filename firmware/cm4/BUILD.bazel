load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Vendored NXP HAL ships with warnings our forge -Werror set would catch.
# Disable them on the HAL libraries only — application code (hello-world,
# etc.) still gets the strict set.
HAL_COPTS = [
    "-Wno-sign-conversion",
    "-Wno-unused-parameter",
    "-Wno-null-dereference",
    "-Wno-switch-enum",
    "-Wno-missing-field-initializers",
    "-Wno-shadow",
]

# ARM CMSIS core (header-only).
cc_library(
    name = "cmsis",
    hdrs = glob(["cmsis/*.h"]),
    includes = ["cmsis"],
)

# NXP MIMXRT1176 device headers + system init source.
cc_library(
    name = "device",
    srcs = glob(["device/*.c"]),
    hdrs = glob(["device/*.h"]),
    includes = ["device"],
    copts = HAL_COPTS,
    deps = [":cmsis"],
)

# NXP fsl_* HAL drivers.
cc_library(
    name = "drivers",
    srcs = glob(["drivers/*.c"]),
    hdrs = glob(["drivers/*.h"]),
    includes = ["drivers"],
    copts = HAL_COPTS,
    deps = [":device"],
)

# UART adapter component.
cc_library(
    name = "uart",
    srcs = glob(["component/uart/*.c"]),
    hdrs = glob(["component/uart/*.h"]),
    includes = ["component/uart"],
    copts = HAL_COPTS,
    deps = [
        ":device",
        ":drivers",
    ],
)

# Misc utilities (debug console, asserts, memcpy).
cc_library(
    name = "utilities",
    srcs = glob([
        "utilities/*.c",
        "utilities/*.S",
    ]),
    hdrs = glob(["utilities/*.h"]),
    includes = ["utilities"],
    copts = HAL_COPTS,
    deps = [
        ":device",
        ":drivers",
        ":uart",
    ],
)

# Board (clock config, pin mux).
cc_library(
    name = "board",
    srcs = glob(["board/*.c"]),
    hdrs = glob(["board/*.h"]),
    includes = ["board"],
    copts = HAL_COPTS,
    deps = [
        ":drivers",
        ":utilities",
    ],
)

# Multicore manager (MUA-based handshake between cm4 and cm7).
cc_library(
    name = "mcmgr",
    srcs = glob(["mcmgr/*.c"]),
    hdrs = glob(["mcmgr/*.h"]),
    includes = ["mcmgr"],
    copts = HAL_COPTS + ["-Wno-cast-align"],
    deps = [
        ":device",
        ":drivers",
    ],
)

# C++ MMIO register wrappers (header-only). Generated from SVD; for now
# we use the committed copies in registers/codegen/.
# `includes = ["."]` means consumers can write `#include "registers/codegen/gpio.hpp"`.
cc_library(
    name = "registers",
    hdrs = glob(["registers/**/*.hpp"]),
    includes = ["."],
    deps = ["@forge//firmware/ftl"],
)

# C++ wrapper headers used by application code.
cc_library(
    name = "drivers_new",
    hdrs = glob(["drivers_new/*.hpp"]),
    includes = ["."],
    deps = [":registers"],
)

# Platform: MPU init, C++ new/delete overrides.
cc_library(
    name = "cm4-platform",
    srcs = ["platform/new_delete.cpp"],
    hdrs = ["platform/mpu.hpp"],
    includes = ["."],
    deps = [":registers"],
)
