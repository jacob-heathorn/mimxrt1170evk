load("@forge//bazel:svd.bzl", "svd_cc_library")
load("//bazel:cores.bzl", "CM4")

# Register headers generated from NXP's SVD, included as "mimxrt/cm4/registers/<peripheral>.hpp".
svd_cc_library(
    name = "registers",
    include_prefix = "mimxrt/cm4/registers",
    svd = "@mimxrt1176_cm4_svd//file",
    target_compatible_with = CM4,
    visibility = ["//visibility:public"],
    deps = ["@forge//forge/ftl"],
)
