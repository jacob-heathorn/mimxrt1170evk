{
  "configurations":
  [
      // Core 0 debug configuration. This launches the LinkServer's GDB Server for BOTH core0 and
      // core1. Then it uses a dedicated GDB session to "launch" core0. Then it uses the
      // cortex-debug "chained configuration" to automatically launch the core1 debug configuration,
      // which uses a separate GDB session to "attach" to core1.
      {
          "name": "core0 (cortex m7)",
          "cwd": "${workspaceRoot}",
          "preLaunchTask": "Launch LinkServer's GDB Server (cm7 & cm4)",
          "executable": "/home/jacob/embedded/nxp/mimxrt1170evk/bin/cm7-debug/test/cm7/hello_world/hello-world-cm7.elf",
          "request": "launch",
          "type": "cortex-debug",
          "servertype": "external",
          "configFiles": [],
          "searchDir": [],
          "runToEntryPoint": "main",
          "armToolchainPath": "/home/jacob/.mcuxpressotools/arm-gnu-toolchain-12.2.rel1-x86_64-arm-none-eabi/bin",
          "gdbPath": "/home/jacob/.mcuxpressotools/arm-gnu-toolchain-12.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
          "gdbTarget": "localhost:2467",
          "showDevDebugOutput":"raw",
          "numberOfProcessors": 1,
          "targetProcessor": 0,
          "preLaunchCommands": [
            "set mem inaccessible-by-default off"
          ],
          "chainedConfigurations": {
            "enabled": true,
            "waitOnEvent": "postInit",
            "lifeCycleShared": true,
            "launches": [
                {
                    "name": "core1 (cortex m4)",
                    "folder": ""
                }
            ]
          }
      },
      // Core1 debug configuration. This is hidden to the user, and can only be launched by the
      // core0 debug config, which is required to start the LinkServer's GDB server for dual core.
      // This configuration simply attaches to core1, which is launched by the core0 application
      // itself.
      //
      // NOTE: When this attaches, it thinks it's paused, but is not. You must hit continue, then
      // you can pause/continue after that. TODO: Fix this, I have tried using a  post attach
      // command to automatically continue, but it breaks things, I think due to timing of the
      // command.
      {
          "cwd": "${workspaceRoot}",
          "presentation": {
            "hidden": true
          },
          "executable": "/home/jacob/embedded/nxp/mimxrt1170evk/bin/cm4-debug/test/cm4/hello_world/hello-world-cm4.elf",
          "name": "core1 (cortex m4)",
          "request": "attach",
          "type": "cortex-debug",
          "servertype": "external",
          "configFiles": [],
          "searchDir": [],
          "breakAfterReset": false,
          "armToolchainPath": "/home/jacob/.mcuxpressotools/arm-gnu-toolchain-12.2.rel1-x86_64-arm-none-eabi/bin",
          "gdbPath": "/home/jacob/.mcuxpressotools/arm-gnu-toolchain-12.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
          "gdbTarget": "localhost:2468",
          "showDevDebugOutput":"raw",
          "numberOfProcessors": 1,
          "targetProcessor": 0,
          "overrideAttachCommands": [
            "set mem inaccessible-by-default off",
          ],
      },
  ]
}
