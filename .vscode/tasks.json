{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Launch LinkServer's GDB Server (cm7 & cm4)",
        "command": "/usr/local/LinkServer_1.4.85/LinkServer",
        "args": [
           "gdbserver",
           "--no-boot",
           "MIMXRT1176xxxxx:MIMXRT1170-EVK",
           "--gdb-port",
           "2457",
           "-c",
           "all"
        ],
        "type": "shell",
        "isBackground": true,
        "problemMatcher": {
          "pattern": [
              {
                  "regexp": ".*",
                  "file": 1,
                  "location": 2,
                  "message": 3
              }
          ],
          "background": {
              "activeOnStart": false,
              "beginsPattern": "^GDB server listening on port.*$",
              "endsPattern": "^Semihosting server listening on port.*$"
          }
        }
    },
