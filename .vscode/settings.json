{
  "python.defaultInterpreterPath": "./scripts/package/.venv/bin/python",
  "[python]": {
      "editor.defaultFormatter": "ms-python.autopep8",
      "editor.formatOnSave": true,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false
  },
  "autopep8.args": [
      "--max-line-length", "100",
      "--indent-size", "2",
      "--aggressive"
  ],
  "flake8.path": ["flake8"],
  "flake8.args": [
      "--indent-size", "2",
      "--max-line-length", "100",
  ],
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 100,

  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.intelliSenseCacheSize": 1024,

  "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
            "scope": "command-identifier.cmake",
            "settings": {
                "foreground": "#DCDCAA"
            }
        },
        {
            "scope": "expression.group.cmake",
            "settings": {
                "foreground": "#9CDCFE"
            }
        }
      ]
  },
  
  "cmake.cmakePath": "cmake",
  "cmake.options.statusBarVisibility": "visible",
  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,

  "cortex-debug.variableUseNaturalFormat": true,

  "files.associations": {
    "array": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "*.tcc": "cpp",
    "bitset": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "compare": "cpp",
    "concepts": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "string": "cpp",
    "unordered_map": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "random": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "initializer_list": "cpp",
    "iosfwd": "cpp",
    "limits": "cpp",
    "new": "cpp",
    "numbers": "cpp",
    "ostream": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "typeinfo": "cpp",
    "fsl_device_registers.h": "c",
    "mcmgr.h": "c",
    "fsl_mu.h": "c",
    "clock_config.h": "c",
    "any": "cpp",
    "ratio": "cpp",
    "variant": "cpp",
    "gpio9.hpp": "c",
    "board.h": "c",
    "condition_variable": "cpp",
    "ctime": "cpp",
    "map": "cpp",
    "set": "cpp",
    "optional": "cpp",
    "fstream": "cpp",
    "iostream": "cpp",
    "istream": "cpp",
    "mutex": "cpp",
    "semaphore": "cpp",
    "span": "cpp",
    "sstream": "cpp",
    "stop_token": "cpp",
    "thread": "cpp",
    "cinttypes": "cpp",
    "cassert": "cpp"
  },
}
