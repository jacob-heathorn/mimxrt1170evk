load("//bazel:cores.bzl", "cm7_image")
load("//tools:multicore.bzl", "embedded_image")

# The cm4 image as a C array for the cm7 image to copy into RAM and start.
embedded_image(
    name = "cm4_image",
    image = "//test/cm4/hello_world:hello-world-cm4",
    platform = "//bazel/platforms:cm4",
    symbol = "hello_world_cm4_bin",
)

# Prints a banner, then boots the cm4.
cm7_image(
    name = "hello-world-cm7",
    srcs = [
        "hello_world_cm7.cpp",
        ":cm4_image",
    ],
    copts = [
        "-Wno-deprecated-declarations",
        "-Wno-shadow",
    ],
    deps = ["//firmware/cm7:runtime"],
)
