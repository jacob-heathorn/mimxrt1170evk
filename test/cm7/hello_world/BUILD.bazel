load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:elf_image.bzl", "firmware_image")

# Stub for the cm4 binary symbols hello_world_cm7.cpp expects. Lets us
# build the cm7 firmware standalone for now; the proper cross-core wiring
# (cm7 image embedding the cm4 .bin.cpp via configuration transition) is
# a follow-up. See TODO.md "Multi-core build orchestration".
cc_library(
    name = "cm4_image_stub",
    srcs = ["cm4_image_stub.cpp"],
)

firmware_image(
    name = "hello-world-cm7",
    srcs = ["hello_world_cm7.cpp"],
    copts = [
        "-Wno-shadow",
        "-Wno-deprecated-declarations",  # std::char_traits / printf %p
    ],
    deps = [
        ":cm4_image_stub",
        "//firmware/cm7:cm7-platform",
        "//firmware/cm7:registers",
        "//firmware/cm7:utils",
        "//firmware/cm7/legacy:board",
        "//firmware/cm7/legacy:cmsis",
        "//firmware/cm7/legacy:drivers",
        "//firmware/cm7/legacy:mcmgr",
        "//firmware/cm7/legacy:utilities",
        "//firmware/cm7/startup:rt1170-startup-cm7",
    ],
    visibility = ["//visibility:public"],
    # `deploy = True` makes `:hello-world-cm7` a runnable that flashes
    # the board and streams serial. The cc_binary moves to
    # `:hello-world-cm7.elf`. With target_platform set, the wrapper
    # transitions its elf data dep to cm7 so the user can run from a
    # host config — `bazel run :hello-world-cm7` (no --config) flashes
    # and streams. CPU flags are still resolved per-platform via the
    # toolchain bound to //platforms:cm7_core.
    deploy = True,
    target_platform = "//platforms:cm7",
)
