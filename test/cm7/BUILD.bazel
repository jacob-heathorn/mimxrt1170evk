load("//bazel:cores.bzl", "cm7_image")
load("//tools:flash.bzl", "flash")
load("//tools:on_target_test.bzl", "on_target_test")

# Echoes UART input back.
cm7_image(
    name = "echo",
    srcs = ["echo.cpp"],
    deps = ["//firmware/cm7:runtime"],
)

# Two ThreadX threads taking turns.
cm7_image(
    name = "hello-threadx",
    srcs = ["hello_threadx.cpp"],
    copts = ["-Wno-write-strings"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# UDP echo over gigabit ethernet.
cm7_image(
    name = "hello-netx",
    srcs = ["hello_netx.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/network",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# Cyphal/UDP heartbeat publisher and subscriber.
[
    cm7_image(
        name = name,
        srcs = [name.replace("-", "_") + ".cpp"],
        deps = [
            "//firmware/cm7:runtime",
            "//firmware/cm7/network",
            "//firmware/cm7/rtos/threadx",
            "@forge//firmware/ftl",
            "@forge//firmware/threadx:ftl-threadx",
            "@microcyphal//firmware:microcyphal",
        ],
    )
    for name in [
        "hello-publisher",
        "hello-subscriber",
    ]
]

# `bazel run` targets that program the board with each image.
[
    flash(
        name = image + ".flash",
        image = ":" + image,
    )
    for image in [
        "echo",
        "hello-threadx",
        "hello-netx",
        "hello-publisher",
        "hello-subscriber",
    ]
]

# Pigweed unit tests that run on the board.
_TESTS = {
    "ut-simple": ["ut_simple.cpp"],
    "ut-memory": [
        "ut_bump_allocators.cpp",
        "ut_bump_pool.cpp",
        "ut_mpu.cpp",
    ],
    "ut-threadx": ["ut_concurrency.cpp"],
}

[
    cm7_image(
        name = name,
        srcs = srcs,
        deps = [
            "//firmware/cm7:runtime",
            "//firmware/cm7/rtos/threadx",
            "//firmware/cm7/rtos/threadx:pw_ut_main",
            "@forge//firmware/ftl",
            "@forge//firmware/pw_unit_test",
            "@forge//firmware/threadx:ftl-threadx",
        ],
    )
    for name, srcs in _TESTS.items()
]

# `bazel test` targets that flash each test image and read its result.
[
    on_target_test(
        name = name + ".test",
        image = ":" + name,
    )
    for name in _TESTS
]
