load("//bazel:cores.bzl", "cm7_image", "cm7_test")

# Echoes UART input back.
cm7_image(
    name = "echo",
    srcs = ["echo.cpp"],
    deps = ["//firmware/cm7:runtime"],
)

# Two ThreadX threads taking turns.
cm7_image(
    name = "hello-threadx",
    srcs = ["hello_threadx.cpp"],
    copts = ["-Wno-write-strings"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# UDP echo over gigabit ethernet.
cm7_image(
    name = "hello-netx",
    srcs = ["hello_netx.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/network",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# Cyphal/UDP heartbeat publisher.
cm7_image(
    name = "hello-publisher",
    srcs = ["hello_publisher.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/network",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
        "@microcyphal//firmware:microcyphal",
    ],
)

# Cyphal/UDP heartbeat subscriber.
cm7_image(
    name = "hello-subscriber",
    srcs = ["hello_subscriber.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/network",
        "//firmware/cm7/rtos/threadx",
        "@forge//firmware/ftl",
        "@forge//firmware/threadx:ftl-threadx",
        "@microcyphal//firmware:microcyphal",
    ],
)

# Checks that the pigweed test framework runs on the board.
cm7_test(
    name = "ut-simple",
    srcs = ["ut_simple.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/rtos/threadx",
        "//firmware/cm7/rtos/threadx:pw_ut_main",
        "@forge//firmware/ftl",
        "@forge//firmware/pw_unit_test",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# The allocators, the bump pool and the MPU regions.
cm7_test(
    name = "ut-memory",
    srcs = [
        "ut_bump_allocators.cpp",
        "ut_bump_pool.cpp",
        "ut_mpu.cpp",
    ],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/rtos/threadx",
        "//firmware/cm7/rtos/threadx:pw_ut_main",
        "@forge//firmware/ftl",
        "@forge//firmware/pw_unit_test",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)

# Mutexes and threads under ThreadX.
cm7_test(
    name = "ut-threadx",
    srcs = ["ut_concurrency.cpp"],
    deps = [
        "//firmware/cm7:runtime",
        "//firmware/cm7/rtos/threadx",
        "//firmware/cm7/rtos/threadx:pw_ut_main",
        "@forge//firmware/ftl",
        "@forge//firmware/pw_unit_test",
        "@forge//firmware/threadx:ftl-threadx",
    ],
)
