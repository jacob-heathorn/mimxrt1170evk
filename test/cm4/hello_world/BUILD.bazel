load("//bazel:cores.bzl", "cm4_image")

# The cm4 side of the dual-core hello world; the cm7 image carries and starts it.
cm4_image(
    name = "hello-world-cm4",
    srcs = ["hello_world_cm4.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//firmware/cm4:cm4-platform",
        "//firmware/cm4:drivers_new",
        "//firmware/cm4/registers",
        "//firmware/cm4/startup:rt1170-startup-cm4",
        "@nxp_cm4//:board",
        "@nxp_cm4//:device",
        "@nxp_cm4//:drivers",
        "@nxp_cm4//:mcmgr",
        "@nxp_cm4//:utilities",
    ],
)
